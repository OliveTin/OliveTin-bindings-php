{
  "name": "jwread/olivetin-bindings-php",
  "description": "PHP client for the OliveTin Connect RPC API — start actions with bearer API-key style credentials",
  "license": "Apache-2.0",
  "type": "library",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2.5",
    "phpunit/phpunit": "^10.5.64",
    "squizlabs/php_codesniffer": "^3.13 || ^4.0.1"
  },
  "autoload": {
    "psr-4": {
      "OliveTin\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OliveTin\\Api\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
